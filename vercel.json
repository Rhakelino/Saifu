{
    "rewrites": [
        {
            "source": "/api/auth/:path*",
            "destination": "/api/auth/[...all]"
        },
        {
            "source": "/api/:path*",
            "destination": "/api/:path*"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}